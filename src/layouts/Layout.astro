---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Pabreetzio — Patrick Graham',
  description = "Pabreetzio is Patrick Graham — software developer, gamer, and Charlotte local. Side quests, gaming, community, and the stuff that doesn't fit anywhere else.",
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, 'https://pabreetzio.com');
const ogImage = 'https://pabreetzio.com/p-logo-new-original.png';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="Pabreetzio" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <title>{title}</title>
  <link rel="icon" type="image/png" href="/favicon-light.png" media="(prefers-color-scheme: light)" />
  <link rel="icon" type="image/png" href="/favicon-dark.png" media="(prefers-color-scheme: dark)" />
  <slot name="head" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Rajdhani:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  :root {
    --bg: #0a0a18;
    --bg-card: #12122a;
    --bg-card-hover: #1a1a35;
    --bg-card-alt: #0f0f24;
    --border: #1e1e40;
    --border-bright: #2a2a55;
    --pink: #e91e8c;
    --pink-glow: rgba(233, 30, 140, 0.3);
    --purple: #7c3aed;
    --purple-light: #a855f7;
    --cyan: #06b6d4;
    --cyan-glow: rgba(6, 182, 212, 0.3);
    --green: #22c55e;
    --yellow: #eab308;
    --orange: #f97316;
    --text: #e2e2f0;
    --text-muted: #6b6b8a;
    --text-dim: #4a4a6a;
    --font-display: 'Orbitron', monospace;
    --font-ui: 'Rajdhani', sans-serif;
    --font-body: 'Inter', sans-serif;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html { scroll-behavior: smooth; }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    min-height: 100vh;
    background-image:
      radial-gradient(ellipse at 20% 50%, rgba(124, 58, 237, 0.05) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 20%, rgba(233, 30, 140, 0.04) 0%, transparent 40%);
  }

  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }
  button { cursor: pointer; border: none; background: none; font-family: inherit; }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--pink);
    color: white;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 15px;
    padding: 12px 24px;
    border-radius: 8px;
    transition: all 0.2s;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    border: none;
  }
  .btn-primary:hover {
    background: #ff35a0;
    transform: translateY(-1px);
    box-shadow: 0 4px 20px var(--pink-glow);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: var(--text);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 15px;
    padding: 12px 24px;
    border-radius: 8px;
    border: 1px solid var(--border-bright);
    transition: all 0.2s;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
  }
  .btn-secondary:hover {
    border-color: var(--cyan);
    color: var(--cyan);
    transform: translateY(-1px);
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .cursor-blink { animation: blink 1s step-end infinite; }

  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border-bright); border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--purple); }
</style>

---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    accent: '#f97316',
    image: '/stride-city-run-club.png',
    imageAlt: 'Stride City Run Club group photo',
    title: 'Stride City Run Club',
    paras: [
      "I started running with Stride City Run Club during the pandemic — at a time when outdoor hangouts were basically the only hangouts. What I didn't expect was finding one of the most genuinely welcoming communities in Charlotte. A weekly run, good people — it became something I didn't want to stop doing.",
      `The club meets within walking distance of my house, and the route passes right through my neighborhood. I ended up building the club's website along the way. My daughters come along too — they bike the route instead of running. After every Wednesday run, we end up at <a href="https://edgecitybrewery-clt.com/" target="_blank">Edge City Brewing</a> — it's as much a part of the week as the run itself. Follow along on <a href="https://www.instagram.com/stridecityrunclub/" target="_blank">Instagram</a> if you want to see what we're up to.`,
    ],
    link: { label: 'stridecityrunclub.com', href: 'https://stridecityrunclub.com' },
    reverse: false,
  },
  {
    accent: '#7c3aed',
    image: '/magical-night-at-tavern.png',
    imageAlt: 'Charlotte Devs meetup',
    title: 'Charlotte Devs',
    paras: [
      "Charlotte Devs is a monthly meetup for developers in Charlotte, and I'm the one keeping the lights on. We get together once a month outside at OMB LOSO — good beer, good conversation, and a crowd of people who spend too much of their time thinking about software. If you're a developer in the area, come say hi.",
    ],
    link: { label: 'Charlotte Devs on Meetup', href: 'https://www.meetup.com/charlottedevs/' },
    reverse: true,
  },
  {
    accent: '#06b6d4',
    image: null,
    imageAlt: null,
    title: 'Hackerspace Charlotte',
    paras: [
      `Hackerspace Charlotte was a community workshop for makers, builders, and tinkerers in the Charlotte area — a physical space where hardware met software and people came to work on things that didn't have a job description. It's no longer active, but the community carries on through <a href="https://www.makerspacecharlotte.org/" target="_blank">Makerspace Charlotte</a>, which is continuing that legacy today.`,
    ],
    link: null,
    reverse: false,
  },
  {
    accent: '#a855f7',
    image: null,
    imageAlt: null,
    title: 'Chess Dawgs',
    paras: [
      "I founded the Chess Dawgs my freshman year of college with a dorm mate. The premise was simple — show up every week with boards and play. We started in the honors dorm, just the two of us and whoever wandered in. Consistency turned out to be the whole strategy. The club gradually grew, and eventually we moved to the Tate Student Center.",
      "From there it took on a life of its own. I made the logo, put up fliers around campus, and built the club's first website. We made a short video, hosted tournaments, and put together a traveling team. There were some genuinely good parties after our victories. It was my first real experience building something from nothing — and it taught me more about showing up and sticking with it than anything else I did in college.",
    ],
    link: null,
    reverse: false,
  },
];
---

<Layout title="Community — Pabreetzio" description="Meetups Patrick Graham runs, clubs he's called home, and the communities that make Charlotte worth showing up for — Stride City Run Club, Charlotte Devs, Chess Dawgs, and more.">
  <Nav />
  <main>
    <div class="hero">
      <img src="/magical-night-at-tavern.png" alt="Community" class="hero-img" />
      <div class="hero-overlay">
        <div class="container hero-content">
          <span class="hero-label">COMMUNITY</span>
          <h1 class="hero-title">Community</h1>
          <p class="hero-desc">Meetups I run, clubs I've called home, and the communities that make Charlotte worth showing up for.</p>
        </div>
      </div>
    </div>

    <div class="sections-list container">
      {sections.map(section => (
        <article class="section-feature" style={`--accent: ${section.accent};`}>
          {section.image ? (
            <div class={`feature-inner ${section.reverse ? 'reverse' : ''}`}>
              <div class="feature-image-wrap">
                <img src={section.image} alt={section.imageAlt} class="feature-image" />
              </div>
              <div class="feature-body">
                <h2 class="feature-title">{section.title}</h2>
                {section.paras.map(p => <p class="feature-para" set:html={p} />)}
                {section.link && (
                  <a href={section.link.href} class="feature-link" target="_blank" style={`color: ${section.accent}; border-color: ${section.accent}44;`}>
                    {section.link.label}
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                )}
              </div>
            </div>
          ) : (
            <div class="feature-inner-text">
              <h2 class="feature-title">{section.title}</h2>
              {section.paras.map(p => <p class="feature-para" set:html={p} />)}
              {section.link && (
                <a href={section.link.href} class="feature-link" target="_blank" style={`color: ${section.accent}; border-color: ${section.accent}44;`}>
                  {section.link.label}
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              )}
            </div>
          )}
        </article>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 360px;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 18, 0.85) 0%, rgba(10, 10, 18, 0.3) 60%, transparent 100%);
    display: flex;
    align-items: flex-end;
  }

  .hero-content {
    padding-bottom: 32px;
  }

  .hero-label {
    display: block;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--yellow);
    margin-bottom: 8px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 900;
    color: var(--text);
    margin-bottom: 8px;
  }

  .hero-desc {
    font-size: 15px;
    color: var(--text-muted);
    max-width: 480px;
  }

  .sections-list {
    padding: 64px 0 80px;
    display: flex;
    flex-direction: column;
  }

  .section-feature {
    border: 1px solid var(--border);
    border-top: 2px solid var(--accent);
    border-radius: 12px;
    background: var(--bg-card);
    overflow: hidden;
    margin-bottom: 60px;
  }

  /* Two-column layout for sections with images */
  .feature-inner {
    display: grid;
    grid-template-columns: 500px 1fr;
  }

  .feature-inner.reverse {
    grid-template-columns: 1fr 500px;
  }

  .feature-inner.reverse .feature-image-wrap {
    order: 2;
  }

  .feature-inner.reverse .feature-body {
    order: 1;
  }

  .feature-image-wrap {
    overflow: hidden;
    background: var(--bg-card);
  }

  .feature-image {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Full-width layout for sections without images */
  .feature-inner-text {
    padding: 40px 56px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 780px;
  }

  .feature-body {
    padding: 36px 48px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-content: center;
  }

  .feature-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 900;
    color: var(--text);
    line-height: 1.1;
  }

  .feature-para {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .feature-para a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }

  .feature-para a:hover {
    text-decoration-color: currentColor;
  }

  .feature-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-family: var(--font-ui);
    font-weight: 600;
    border: 1px solid;
    border-radius: 6px;
    padding: 7px 14px;
    text-decoration: none;
    width: fit-content;
    margin-top: 4px;
    transition: gap 0.2s, opacity 0.2s;
    background: transparent;
  }

  .feature-link:hover {
    gap: 10px;
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .hero {
      height: 240px;
    }

    .sections-list {
      padding: 32px 24px 48px;
    }

    .section-feature {
      margin-bottom: 32px;
    }

    .feature-inner,
    .feature-inner.reverse {
      grid-template-columns: 1fr;
    }

    .feature-inner.reverse .feature-image-wrap {
      order: 1;
    }

    .feature-inner.reverse .feature-body {
      order: 2;
    }

    .feature-image-wrap {
      border-bottom: 1px solid var(--border);
    }

    .feature-body {
      padding: 20px 20px 24px;
      gap: 10px;
    }

    .feature-inner-text {
      padding: 24px 20px;
    }
  }
</style>

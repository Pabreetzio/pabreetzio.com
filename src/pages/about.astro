---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="About — Pabreetzio">
  <Nav />
  <main class="placeholder-page container">
    <div class="coming-soon">
      <div class="cs-icon">🧑‍🚀</div>
      <h1>About</h1>
      <p>This page is under construction. Check back soon!</p>
      <a href="/" class="btn-primary">← Back Home</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .placeholder-page {
    min-height: calc(100vh - 128px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .coming-soon {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .cs-icon { font-size: 64px; }
  h1 {
    font-family: var(--font-display);
    font-size: 36px;
    color: var(--text);
  }
  p { color: var(--text-muted); }
</style>

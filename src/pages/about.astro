---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="About — Pabreetzio">
  <Nav />
  <main>
    <div class="hero">
      <img src="/pickleball.png" alt="Random Interests" class="hero-img" />
      <div class="hero-overlay">
        <div class="container hero-content">
          <span class="hero-label">CURRENTLY INTO</span>
          <h1 class="hero-title">Random Interests</h1>
          <p class="hero-desc">Synthwave, retro tech, coffee, design, memes, and collecting fun rabbit holes.</p>
        </div>
      </div>
    </div>
    <div class="placeholder-page container">
      <div class="coming-soon">
        <p>This page is under construction. Check back soon!</p>
        <a href="/" class="btn-primary">← Back Home</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 360px;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% 15%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 18, 0.85) 0%, rgba(10, 10, 18, 0.3) 60%, transparent 100%);
    display: flex;
    align-items: flex-end;
  }

  .hero-content {
    padding-bottom: 32px;
  }

  .hero-label {
    display: block;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--pink);
    margin-bottom: 8px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 900;
    color: var(--text);
    margin-bottom: 8px;
  }

  .hero-desc {
    font-size: 15px;
    color: var(--text-muted);
    max-width: 480px;
  }

  .placeholder-page {
    padding: 48px 0 80px;
  }

  .coming-soon {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  p { color: var(--text-muted); }
</style>

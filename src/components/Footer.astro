---
import MinecraftCharacter from './MinecraftCharacter.astro';
---

<footer class="footer">
  <div class="footer-cityscape" aria-hidden="true">
    <div class="city-buildings">
      {Array.from({length: 20}).map((_, i) => (
        <div class="building" style={`height: ${30 + (i * 7) % 50}px; width: ${18 + (i * 5) % 20}px; left: ${i * 5}%;`}></div>
      ))}
    </div>
  </div>

  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <img src="/p-logo-black.png" alt="Pabreetzio" class="footer-logo-img" />
        <span class="footer-logo-text">pabreetzio.com</span>
      </a>
      <p class="footer-tagline">Thanks for visiting! Stay curious. <span class="footer-heart">💜</span></p>
    </div>

    <div class="starship-badge">
      <span class="starship-dot"></span>
      <div class="starship-text">
        <span class="starship-title">STARSHIP ONLINE</span>
        <span class="starship-sub">All systems nominal</span>
      </div>
    </div>

    <div class="footer-pixel-char">
      <div class="speech-bubble">
        Be kind. Have fun.<br />Save often. <span>✨</span>
      </div>
      <div class="pixel-character" aria-hidden="true">
        <MinecraftCharacter width={60} height={100} id="mc-footer" />
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    padding-top: 60px;
    overflow: hidden;
  }

  .footer-cityscape {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    pointer-events: none;
  }

  .city-buildings {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
  }

  .building {
    position: absolute;
    bottom: 0;
    background: linear-gradient(to top, #0a0818, #12102a);
    border-top: 1px solid #1e1a3a;
    opacity: 0.6;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 24px;
    position: relative;
    z-index: 1;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .footer-logo-img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    filter: invert(1) drop-shadow(0 0 8px rgba(100, 160, 255, 0.5));
  }

  .footer-logo-text {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
  }

  .footer-tagline {
    font-size: 13px;
    color: var(--text-muted);
    padding-left: 52px;
  }

  .footer-heart {
    font-size: 14px;
  }

  .footer-pixel-char {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    position: relative;
  }

  .speech-bubble {
    background: var(--bg);
    border: 1px solid var(--border-bright);
    border-radius: 12px;
    border-top-right-radius: 2px;
    padding: 12px 16px;
    font-size: 13px;
    color: var(--text);
    line-height: 1.6;
    max-width: 200px;
    position: relative;
  }

  .speech-bubble::after {
    content: '';
    position: absolute;
    top: 10px;
    right: -9px;
    width: 0;
    height: 0;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    border-left: 9px solid var(--border-bright);
  }

  .speech-bubble::before {
    content: '';
    position: absolute;
    top: 11px;
    right: -7px;
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 7px solid var(--bg);
    z-index: 1;
  }

  .pixel-character {
    filter: drop-shadow(0 0 10px rgba(124, 58, 237, 0.4));
  }

  .starship-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 18px;
  }

  .starship-dot {
    width: 10px;
    height: 10px;
    background: var(--green);
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 8px var(--green);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 4px var(--green); }
    50% { box-shadow: 0 0 14px var(--green), 0 0 24px rgba(34, 197, 94, 0.4); }
  }

  .starship-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .starship-title {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--green);
  }

  .starship-sub {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }
</style>

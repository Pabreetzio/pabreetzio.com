---
---

<section class="hero">
  <div class="container hero-grid">

    <!-- Left: Text content -->
    <div class="hero-left">
      <h1 class="hero-title">
        WELCOME TO<br/>
        <span class="title-accent">MY CORNER OF</span><br/>
        THE GALAXY
      </h1>

      <p class="hero-tagline">
        Gamer. Tinkerer. Creator. Explorer of fun corners of the
        internet and collector of curiosities. Join me for adventures,
        side quests, and experiments from the edge of the map.
      </p>

      <div class="hero-ctas">
        <a href="/about" class="btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
          Explore the Station
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="mission-bar">
        <span class="mission-star">✦</span>
        <span class="mission-label">MISSION ACTIVE:</span>
        <span class="mission-text">Have fun. Build cool things. Be kind.</span>
      </div>
    </div>

    <!-- Right: Bridge viewport -->
    <div class="hero-right">
      <div class="bridge-frame">
        <!-- Corner brackets -->
        <div class="corner tl"></div>
        <div class="corner tr"></div>
        <div class="corner bl"></div>
        <div class="corner br"></div>

        <!-- The image -->
        <img
          src="/commanding-the-cosmic-frontier.png"
          alt="Commander at the starship bridge"
          class="bridge-img"
        />

        <!-- HUD status bar -->
        <div class="hud-bar">
          <div class="hud-stat">
            <span class="hud-bar-track"><span class="hud-bar-fill full"></span></span>
            <span class="hud-label">FUEL 100%</span>
          </div>
          <div class="hud-divider"></div>
          <div class="hud-stat">
            <span class="hud-bar-track"><span class="hud-bar-fill full"></span></span>
            <span class="hud-label">SHIELDS 100%</span>
          </div>
          <div class="hud-divider"></div>
          <div class="hud-stat">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="hud-icon"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
            <span class="hud-label">CREW 1 + 1</span>
          </div>
          <div class="hud-divider"></div>
          <div class="hud-stat morale">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="hud-icon"><path d="M3.5 18.5l6-6 4 4L22 6.92"/><path d="M3.5 18.5l6-6 4 4L22 6.92" stroke="currentColor" stroke-width="2" fill="none"/></svg>
            <span class="hud-label">MORALE HIGH</span>
          </div>
        </div>

        <!-- Scan line -->
        <div class="scan-line"></div>
      </div>
    </div>

  </div>
</section>

<style>
  .hero {
    padding: 40px 0 32px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -80px;
    left: -100px;
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(124, 58, 237, 0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 40px;
    align-items: center;
  }

  /* ── Left ── */
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Starship badge */
  .starship-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 16px;
    width: fit-content;
  }

  .online-dot {
    width: 10px;
    height: 10px;
    background: var(--green);
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 8px var(--green);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 4px var(--green); }
    50% { box-shadow: 0 0 14px var(--green), 0 0 24px rgba(34, 197, 94, 0.4); }
  }

  .badge-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .badge-title {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--green);
  }

  .badge-sub {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  /* Title */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 4.2vw, 54px);
    font-weight: 900;
    line-height: 1.05;
    color: white;
    letter-spacing: -0.5px;
  }

  .title-accent {
    color: var(--cyan);
    text-shadow: 0 0 40px rgba(6, 182, 212, 0.4);
  }

  .hero-tagline {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 440px;
  }

  /* CTAs */
  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Mission bar */
  .mission-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }

  .mission-star {
    color: var(--yellow);
    font-size: 11px;
    filter: drop-shadow(0 0 6px var(--yellow));
  }

  .mission-label {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--yellow);
    font-weight: 700;
  }

  .mission-text {
    color: var(--text-muted);
    font-size: 13px;
  }

  /* ── Right: Bridge frame ── */
  .hero-right {
    position: relative;
  }

  .bridge-frame {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-bright);
    background: #05050f;
    box-shadow:
      0 0 0 1px rgba(6, 182, 212, 0.08),
      0 0 40px rgba(6, 182, 212, 0.06),
      0 0 80px rgba(124, 58, 237, 0.08);
  }

  /* Corner brackets */
  .corner {
    position: absolute;
    width: 18px;
    height: 18px;
    z-index: 4;
  }
  .corner.tl { top: 10px; left: 10px; border-top: 2px solid var(--cyan); border-left: 2px solid var(--cyan); }
  .corner.tr { top: 10px; right: 10px; border-top: 2px solid var(--cyan); border-right: 2px solid var(--cyan); }
  .corner.bl { bottom: 10px; left: 10px; border-bottom: 2px solid var(--cyan); border-left: 2px solid var(--cyan); }
  .corner.br { bottom: 10px; right: 10px; border-bottom: 2px solid var(--cyan); border-right: 2px solid var(--cyan); }

  /* Coordinates overlay */
  .coord-display {
    position: absolute;
    top: 18px;
    right: 22px;
    z-index: 4;
    background: rgba(4, 4, 20, 0.75);
    border: 1px solid rgba(6, 182, 212, 0.3);
    border-radius: 6px;
    padding: 10px 14px;
    backdrop-filter: blur(6px);
    min-width: 160px;
  }

  .coord-label {
    font-family: var(--font-display);
    font-size: 9px;
    letter-spacing: 1.5px;
    color: var(--cyan);
    margin-bottom: 8px;
    font-weight: 700;
  }

  .coord-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 4px;
  }

  .coord-key {
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--text-muted);
  }

  .coord-val {
    font-family: var(--font-display);
    font-size: 10px;
    color: var(--cyan);
    letter-spacing: 0.5px;
  }

  .coord-pip {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
    margin-top: 8px;
    animation: pulse-dot 2s ease-in-out infinite 0.5s;
  }

  /* The image */
  .bridge-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* HUD bar */
  .hud-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 4;
    background: linear-gradient(to top, rgba(4, 4, 20, 0.92) 0%, rgba(4, 4, 20, 0.7) 60%, transparent 100%);
    padding: 24px 20px 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .hud-stat {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 600;
  }

  .hud-stat.morale {
    color: var(--green);
  }

  .hud-icon {
    color: inherit;
    flex-shrink: 0;
  }

  .hud-bar-track {
    display: inline-block;
    width: 28px;
    height: 3px;
    background: rgba(255,255,255,0.15);
    border-radius: 2px;
    overflow: hidden;
  }

  .hud-bar-fill {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: var(--cyan);
    box-shadow: 0 0 6px var(--cyan);
  }

  .hud-bar-fill.full { width: 100%; }

  .hud-divider {
    width: 1px;
    height: 18px;
    background: rgba(255,255,255,0.15);
    flex-shrink: 0;
  }

  .hud-label {
    white-space: nowrap;
  }

  /* Scan line */
  .scan-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
    opacity: 0.4;
    animation: scan 6s linear infinite;
    z-index: 3;
  }

  @keyframes scan {
    0%   { top: 0%; opacity: 0.4; }
    50%  { opacity: 0.15; }
    100% { top: 100%; opacity: 0.4; }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .coord-display {
      display: none;
    }
  }
</style>

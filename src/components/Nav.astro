---
const { pathname } = Astro.url;
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Gaming', href: '/gaming' },
  { label: 'Projects', href: '/projects' },
  { label: 'Media', href: '/media' },
  { label: 'Links', href: '/links' },
].map(link => ({
  ...link,
  active: link.href === '/' ? pathname === '/' : pathname.startsWith(link.href),
}));
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="logo">
      <img src="/p-logo-black.png" alt="Pabreetzio" class="logo-img" />
      <span class="logo-text">Pabreetzio</span>
    </a>

    <ul class="nav-links">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class:list={['nav-link', { active: link.active }]}>
            {link.label}
            {link.active && <span class="nav-dot"></span>}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-icons">
      <button class="nav-icon-btn" aria-label="Gaming" title="Gaming">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="6" width="20" height="12" rx="4"/>
          <line x1="8" y1="12" x2="8" y2="12"/>
          <line x1="6" y1="10" x2="10" y2="10"/>
          <line x1="6" y1="12" x2="10" y2="12"/>
          <line x1="6" y1="14" x2="10" y2="14"/>
          <circle cx="16" cy="10" r="1" fill="currentColor"/>
          <circle cx="18" cy="12" r="1" fill="currentColor"/>
        </svg>
      </button>
      <button class="nav-icon-btn heart filled" aria-label="Favorites">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </button>
      <button class="nav-icon-btn heart" aria-label="Wishlist">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </button>
      <button class="nav-icon-btn wishlist" aria-label="Wishlist empty">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10, 10, 24, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 64px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    text-decoration: none;
  }

  .logo-img {
    width: 40px;
    height: 40px;
    object-fit: contain;
    filter: invert(1) drop-shadow(0 0 8px rgba(100, 160, 255, 0.5));
  }

  .logo-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    color: var(--text);
    letter-spacing: 0.5px;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 4px;
    margin: 0 auto;
  }

  .nav-link {
    position: relative;
    display: block;
    padding: 6px 16px;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 15px;
    color: var(--text-muted);
    border-radius: 6px;
    transition: color 0.2s;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link.active {
    color: var(--pink);
    font-weight: 600;
  }

  .nav-dot {
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 5px;
    height: 5px;
    background: var(--pink);
    border-radius: 50%;
  }

  .nav-icons {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .nav-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    transition: all 0.2s;
    cursor: pointer;
  }

  .nav-icon-btn:hover {
    color: var(--text);
    border-color: var(--border-bright);
  }

  .nav-icon-btn.filled {
    color: var(--pink);
  }

  .nav-icon-btn.heart {
    color: #e05882;
  }

  .nav-icon-btn.wishlist {
    color: var(--text-dim);
  }
</style>

---
const items = [
  {
    icon: '🎮',
    image: '/gaming-in-ac-hoodie.png',
    color: 'purple',
    accent: 'rgba(124, 58, 237, 1)',
    accentDim: 'rgba(124, 58, 237, 0.3)',
    accentFaint: 'rgba(124, 58, 237, 0.08)',
    tag: '#GAMING',
    title: 'Gaming',
    desc: 'Story-rich adventures, cozy indies, and a healthy dose of chaos.',
    href: '/gaming',
    rgbLight: true,
  },
  {
    icon: '💻',
    image: '/tinkering-with-magic-clocks-3-4.png',
    color: 'cyan',
    accent: 'rgba(6, 182, 212, 1)',
    accentDim: 'rgba(6, 182, 212, 0.3)',
    accentFaint: 'rgba(6, 182, 212, 0.08)',
    tag: '#SIDE PROJECTS',
    title: 'Side Projects',
    desc: 'Building weird ideas, tiny tools, and things that make me go "heck yeah."',
    href: '/projects',
  },
  {
    icon: '🫂',
    image: '/magical-night-at-tavern-3-4.png',
    color: 'yellow',
    accent: 'rgba(234, 179, 8, 1)',
    accentDim: 'rgba(234, 179, 8, 0.3)',
    accentFaint: 'rgba(234, 179, 8, 0.08)',
    tag: '#COMMUNITY',
    title: 'Community',
    desc: 'Meetups I run, clubs I\'ve called home, and the communities that make Charlotte worth showing up for.',
    href: '/community',
  },
  {
    icon: '🎲',
    image: '/pickleball.png',
    color: 'pink',
    accent: 'rgba(233, 30, 140, 1)',
    accentDim: 'rgba(233, 30, 140, 0.3)',
    accentFaint: 'rgba(233, 30, 140, 0.08)',
    tag: '#RANDOM',
    title: 'Random Interests',
    desc: 'Soccer, Pokémon tournaments with my daughter, pickleball, genealogy, and a few things that resist easy labels.',
    href: '/about',
  },
];
---

<section class="currently-into">
  <div class="container">
    <div class="section-header">
      <span class="section-icon">⚡</span>
      <span class="section-title">CURRENTLY INTO</span>
    </div>

    <div class="cards-grid">
      {items.map(item => (
        <a
          href={item.href}
          class="into-card"
          style={`--accent: ${item.accent}; --accent-dim: ${item.accentDim}; --accent-faint: ${item.accentFaint};`}
        >
          <div class="card-art" style={`border-color: ${item.accentDim};`}>
            {item.image
              ? <img src={item.image} alt={item.title} class="card-img" />
              : <span class="card-placeholder-icon">{item.icon}</span>
            }
            {item.rgbLight && <img src="/gaming-overlay-3.png" class="mouse-rgb-overlay" alt="" aria-hidden="true" />}
          </div>
          <div class="card-body">
            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.desc}</p>
            <span class="card-tag" style={`color: ${item.accent}; border-color: ${item.accentDim}; background: ${item.accentFaint};`}>
              {item.tag}
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .currently-into {
    padding: 8px 0 24px;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .section-icon {
    font-size: 16px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--text-muted);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .into-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.2s;
    display: block;
  }

  .into-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-dim);
    box-shadow: 0 8px 30px rgba(0,0,0,0.3);
  }

  .card-art {
    aspect-ratio: 3 / 4;
    border-bottom: 1px solid;
    overflow: hidden;
    background: #0a0a18;
    position: relative;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-position: center top;
    display: block;
    transition: transform 0.3s ease;
  }

  .into-card:hover .card-img {
    transform: scale(1.04);
  }

  .card-placeholder-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 48px;
    opacity: 0.8;
  }

  .card-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .card-title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 14px;
    color: var(--text);
  }

  .card-desc {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .card-tag {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid;
    font-size: 10px;
    font-family: var(--font-display);
    letter-spacing: 0.5px;
    font-weight: 600;
    width: fit-content;
    margin-top: 2px;
  }

  .mouse-rgb-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
    animation: hue-spin 10s linear infinite;
    transition: transform 0.3s ease;
  }

  .into-card:hover .mouse-rgb-overlay {
    transform: scale(1.04);
  }

  @keyframes hue-spin {
    from { filter: hue-rotate(0deg); }
    to   { filter: hue-rotate(360deg); }
  }

  @media (max-width: 700px) {
    .cards-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .into-card {
      display: flex;
      flex-direction: row;
    }

    .card-art {
      aspect-ratio: unset;
      width: 120px;
      min-width: 120px;
      height: auto;
      border-bottom: none;
      border-right: 1px solid;
    }

    .card-body {
      flex: 1;
      padding: 12px 14px;
    }
  }
</style>
